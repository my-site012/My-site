{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-site2",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "my-site2"
    }
  ],
  "observability": {
    "enabled": true
  }
}
